{
	admin off
	auto_https off
	servers {
		# Requests arrive through a reverse proxy; keep the visitor's
		# forwarded address so the contact API can rate-limit per visitor.
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv/orbit
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	redir /index.html / 301

	# The contact form posts here. Point this at whatever service keeps your inbox: it
	# should accept JSON { name, email, message, website } and answer { ok: true }, or
	# 422 with { errors: { field: message } } (see contact.js).
	handle /api/contact {
		reverse_proxy contact-api:3001
	}
	handle /api/* {
		respond 404
	}

	# Scripts and styles get a content hash in their URL at build time (see Dockerfile),
	# so they can be cached for a year. HTML must always revalidate.
	@versioned query v=*
	header @versioned Cache-Control "public, max-age=31536000, immutable"
	@pages path / *.html
	header @pages Cache-Control "no-cache"

	handle {
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
